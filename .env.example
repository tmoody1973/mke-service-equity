# Pooled PostgreSQL connection used by the application at runtime.
DATABASE_URL=

# Direct PostgreSQL connection preferred for database migrations.
DATABASE_URL_UNPOOLED=

# Public browser-readable MapLibre style URL.
NEXT_PUBLIC_MAP_STYLE_URL=/map-style.json

# Installation-only HeroUI Pro credential; never expose it to browser code.
HEROUI_AUTH_TOKEN=

# Optional Census API key used by local ingestion commands.
CENSUS_API_KEY=

# Pipeline target guard. Use "local" or "test" for development workflows.
MKE_PIPELINE_ENV=

# Atlas data mode. Leave blank or use "published" for the public fail-closed path.
# Local development may use "validated_preview" with one exact validated Food run ID.
MKE_ATLAS_DATA_MODE=
MKE_ATLAS_PREVIEW_RUN_ID=

# Local path to the pinned MobilityData GTFS Validator v8.0.1 CLI JAR.
# Expected SHA-256: 19293ddd9b6f954f216d4f12054bd8a3232921751c4484339e339764a91000e2
MKE_GTFS_VALIDATOR_JAR=
